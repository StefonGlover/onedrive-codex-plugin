ONEDRIVE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
ONEDRIVE_TENANT="common"
ONEDRIVE_SCOPES="offline_access User.Read Files.ReadWrite"
# Optional for live deleted-item restore on personal OneDrive:
# ONEDRIVE_SCOPES="offline_access User.Read Files.ReadWrite Files.ReadWrite.All"
ONEDRIVE_KEYCHAIN_SERVICE="Codex OneDrive"
ONEDRIVE_STORAGE_ROOT="$HOME/.codex/onedrive-plugin"
ONEDRIVE_CACHE_ROOT="$HOME/.codex/onedrive-plugin/cache"
ONEDRIVE_CACHE_TTL_SECONDS="900"
ONEDRIVE_MAX_SCAN_DEPTH="25"
ONEDRIVE_MAX_INDEXED_FILE_SIZE="524288"
ONEDRIVE_INDEX_EXTENSIONS=".txt,.md,.csv,.json,.jsonl,.xml,.yaml,.yml,.html,.css,.js,.mjs,.ts,.tsx,.py,.sql,.log"
ONEDRIVE_CONCURRENCY_LIMIT="2"
ONEDRIVE_DELTA_SYNC_ENABLED="true"
ONEDRIVE_CONTENT_INDEX_ENABLED="true"
ONEDRIVE_INDEX_OFFICE_EXPORT="false"

# Optional ChatGPT Work / delegated MCP OAuth mode. Keep the Entra API identity
# (`api://...`) separate from the externally visible HTTPS MCP identity.
ONEDRIVE_MCP_AUTH_MODE="noauth"
# ONEDRIVE_MCP_OAUTH_TENANT="consumers"
# ONEDRIVE_MCP_OAUTH_API_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# ONEDRIVE_MCP_OAUTH_API_CLIENT_SECRET_FILE="/run/onedrive-runtime/oauth-api-client.secret"
# ONEDRIVE_MCP_OAUTH_API_RESOURCE="api://00000000-0000-0000-0000-000000000000"
# ONEDRIVE_MCP_OAUTH_API_SCOPE="api://00000000-0000-0000-0000-000000000000/access_as_user"
# ONEDRIVE_MCP_OAUTH_SCOPE_CLAIM="access_as_user"
# ONEDRIVE_MCP_OAUTH_AUDIENCE="00000000-0000-0000-0000-000000000000"
# ONEDRIVE_MCP_OAUTH_ALLOWED_CLIENT_IDS="11111111-1111-4111-8111-111111111111"
# ONEDRIVE_MCP_OAUTH_AUTHORITY="https://login.microsoftonline.com/consumers/v2.0"
# ONEDRIVE_MCP_OAUTH_AUTHORIZATION_SERVER="https://public-oauth-compat.example"
# ONEDRIVE_MCP_OAUTH_OBO_TOKEN_ENDPOINT="https://login.microsoftonline.com/9188040d-6c67-4c5b-b112-36a304b66dad/oauth2/v2.0/token"
# ONEDRIVE_MCP_OAUTH_GRAPH_SCOPES="https://graph.microsoft.com/.default"

# Use the exact externally visible HTTPS tunnel values, never api:// identifiers
# or loopback URLs. Secure MCP Tunnel rewrites same-tunnel PRM `resource` and
# WWW-Authenticate `resource_metadata` values to its public service URLs.
# ONEDRIVE_MCP_PROTECTED_RESOURCE="https://exact-public-tunnel-mcp-endpoint.example"
# ONEDRIVE_MCP_RESOURCE_METADATA_URL="https://exact-public-tunnel-protected-resource-metadata.example"

# Entra v2 rejects ChatGPT's standards-based `resource` parameter. The
# compatibility service validates the exact request and removes only that
# parameter. Publish port 3010 through a trusted HTTPS proxy, not directly.
# ONEDRIVE_OAUTH_COMPAT_ENABLED="true"
# ONEDRIVE_OAUTH_COMPAT_HOST="0.0.0.0"
# ONEDRIVE_OAUTH_COMPAT_PORT="3010"
# ONEDRIVE_OAUTH_COMPAT_PUBLIC_ISSUER="https://public-oauth-compat.example"
# ONEDRIVE_OAUTH_COMPAT_PROTECTED_RESOURCE="https://exact-public-tunnel-mcp-endpoint.example"
# ONEDRIVE_OAUTH_COMPAT_CLIENT_ID="11111111-1111-4111-8111-111111111111"
# ONEDRIVE_OAUTH_COMPAT_CLIENT_SECRET_FILE="/run/onedrive-runtime/oauth-chatgpt-client.secret"
# ONEDRIVE_OAUTH_COMPAT_REDIRECT_URI="https://chatgpt.com/connector/oauth/your-callback-id"
# ONEDRIVE_OAUTH_COMPAT_SCOPES="api://00000000-0000-0000-0000-000000000000/access_as_user offline_access"
# ONEDRIVE_OAUTH_COMPAT_UPSTREAM_SCOPES="api://00000000-0000-0000-0000-000000000000/.default offline_access"
# Preferred: public client with mandatory S256 PKCE.
# ONEDRIVE_OAUTH_COMPAT_OUTER_TOKEN_AUTH_METHOD="none"
# ONEDRIVE_OAUTH_COMPAT_ALLOW_CONFIDENTIAL_NO_PKCE="false"
# ONEDRIVE_OAUTH_COMPAT_ALLOW_PUBLIC_NO_PKCE="true"
# Verified ChatGPT predefined-client fallback only:
# ONEDRIVE_OAUTH_COMPAT_OUTER_TOKEN_AUTH_METHOD="client_secret_post"
# ONEDRIVE_OAUTH_COMPAT_ALLOW_CONFIDENTIAL_NO_PKCE="true"
# ONEDRIVE_OAUTH_COMPAT_ALLOW_PUBLIC_NO_PKCE="false"
# ONEDRIVE_OAUTH_COMPAT_REFRESH_STORE_FILE="/data/auth/oauth-compat-refresh-handles.json"
# ONEDRIVE_OAUTH_COMPAT_REFRESH_STORE_KEY_FILE="/run/onedrive-runtime/auth-vault.key"
# ONEDRIVE_OAUTH_COMPAT_PROVIDER_CALLBACK_URI="https://public-oauth-compat.example/callback"
